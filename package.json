{
  "name": "vistula-racing-site",
  "version": "1.0.0",
  "description": "Cinematic digital archive for Vistula Racing.",
  "private": true,
  "type": "module",
  "main": "js/app.js",
  "scripts": {
    "build": "node scripts/build-app.mjs && node scripts/build-site.mjs",
    "check": "node scripts/check-source.mjs && node scripts/check-contrast.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "assets:build": "node scripts/build-images.mjs",
    "assets:brand": "node scripts/build-brand.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && npm run check && npm run smoke",
